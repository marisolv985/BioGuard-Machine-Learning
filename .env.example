# ===== BioGuard ML microservicio — configuración (prefijo BIOGUARD_) =====
BIOGUARD_APP_ENV=development
BIOGUARD_APP_VERSION=2.0.0
BIOGUARD_DEBUG=false
BIOGUARD_HOST=0.0.0.0
BIOGUARD_PORT=8000
BIOGUARD_LOG_LEVEL=INFO

# MongoDB Atlas — usuario aislado: read en <source_db> y readWrite en bioguard_ml.
# NO uses credenciales del backend; crea un usuario dedicado en Database Access.
BIOGUARD_MONGO_URI=mongodb+srv://<ml-user>:<password>@<cluster>.mongodb.net
BIOGUARD_SOURCE_DB=bioguard
BIOGUARD_ML_DB=bioguard_ml

# JWT servicio-a-servicio: firmado por el backend .NET con clave dedicada (no la de usuarios).
BIOGUARD_SERVICE_AUDIENCE=ml-service
BIOGUARD_SERVICE_ISSUER=BioGuardApi
BIOGUARD_SERVICE_TOKEN_SECRET=<clave-secreta-min-32-caracteres>

# Predictor y modelo
BIOGUARD_PREDICTOR_ACTIVO=baseline
BIOGUARD_UMBRAL_CRITICO=0.85
BIOGUARD_BASELINE_PESO_PEOR_SENAL=0.6
BIOGUARD_PROBABILIDAD_MOCK=0.85
BIOGUARD_WINDOW_SIZE=12
BIOGUARD_WINDOW_HORIZON_MIN=120
BIOGUARD_MIN_LECTURAS_BASELINE=50
BIOGUARD_MODELO_MIN_MUESTRAS=30
BIOGUARD_CORS_ORIGINS=["https://bioguard.app"]

# Worker de sincronización y reentrenamiento
BIOGUARD_WORKER_SYNC_ENABLED=true
BIOGUARD_FEATURES_TTL_DAYS=90
BIOGUARD_RETRAIN_CRON=0 3 * * 0
